NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nestro?replicaSet=rs0
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-another-random-secret
# Keep your old key to migrate existing encrypted passwords on successful login.
CRYPTR_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nestro
# Only set after checking your actual trusted reverse-proxy topology:
# TRUST_PROXY_HOPS=1
