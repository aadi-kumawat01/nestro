# Copy this file to .env.staging. Never commit .env.staging or paste its values in chat.
# The URI must point only to the restored Atlas database: nestro_staging.
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://STAGING_DATABASE_USER:REPLACE_ME@CLUSTER_HOST/nestro_staging?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3001

# Generate separate random secrets for staging. Do not reuse production values.
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-new-random-secret
CRYPTR_SECRET_KEY=

# The API never runs jobs. Run `npm run worker` only for an intentionally configured worker process.
# Keep email credentials blank during staging tests so copied outbox records cannot deliver customer email.
WORKER_INTERVAL_MS=60000
# After this many failed cycles, the worker exits non-zero so the hosting platform can restart it and alert.
WORKER_MAX_CONSECUTIVE_FAILURES=3

# Leave live payment and email credentials blank. Use dedicated test/sandbox values only when a test explicitly requires them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
# Set only after reviewing the actual staging reverse-proxy topology.
# TRUST_PROXY_HOPS=1
